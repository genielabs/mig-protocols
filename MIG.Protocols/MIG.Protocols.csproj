<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>MIG.Protocols</PackageId>
    <Title>Protocols Interface (UPnP)</Title>
    <Version>1.3.0</Version>
    <Authors>Generoso Martello</Authors>
    <Company>G-Labs</Company>
    <Description>Interface for MIG service that adds commands for controlling UPnP devices.</Description>
    <PackageLicense>./LICENSE</PackageLicense>
    <PackageProjectUrl>https://github.com/genielabs/mig-protocols/</PackageProjectUrl>
    <PackageTags>mig interface mig-service protocols upnp</PackageTags>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Link>README.md</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MIG" Version="1.3.10" />
    <PackageReference Include="MIG.HomeAutomation" Version="1.3.2" />
    <PackageReference Include="UPnP" Version="1.2.1" />
  </ItemGroup>

</Project>
